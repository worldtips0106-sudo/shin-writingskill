---
import { site, about, mainCta } from "../data/site";
import CtaButton from "./CtaButton.astro";
---

<header id="top" class="pt-8 pb-4 sm:pt-12 lg:pt-14 lg:pb-12">
  <!-- PCは「文字が左・写真が右」の2カラム。スマホは文字の下に写真 -->
  <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:items-center lg:gap-12">
    <div class="text-center lg:text-left">
      <p class="text-[13px] tracking-[0.2em] text-accent">
        {about.role}
      </p>

      <h1
        class="mt-3 text-[28px] leading-tight font-black tracking-tight sm:text-[34px] lg:mt-4 lg:text-[44px]"
      >
        {site.name}
      </h1>

      <p
        class="mx-auto mt-4 max-w-[26em] text-[15px] text-ink-muted lg:mx-0 lg:mt-5 lg:text-[17px]"
      >
        {site.tagline}
      </p>

      <!-- 一番押したいボタン（1つだけ置く） -->
      <div class="mx-auto mt-8 max-w-[380px] lg:mx-0 lg:mt-9">
        <CtaButton href={mainCta.url} label={mainCta.label} />
        {
          mainCta.note && (
            <p class="mt-3 text-center text-[12px] text-ink-muted lg:text-left">
              {mainCta.note}
            </p>
          )
        }
      </div>
    </div>

    {
      site.heroImage && (
        /* スマホでは画面いっぱいに広げる */
        <div class="-mx-5 mt-10 sm:-mx-6 lg:mx-0 lg:mt-0">
          <img
            src={site.heroImage}
            alt={site.heroImageAlt}
            width="1536"
            height="1024"
            fetchpriority="high"
            decoding="async"
            class="w-full bg-surface-2 object-cover lg:rounded-2xl"
          />
        </div>
      )
    }
  </div>
</header>
