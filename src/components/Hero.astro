---
import { site, mainCta } from "../data/site";
import CtaButton from "./CtaButton.astro";
---

<!--
  スマホ：見出し → 画像 → キャッチ → ボタン の縦並び（中央揃え）
  PC　　：左に「見出し・キャッチ・ボタン」、右に画像（縦位置は中央）の2カラム
-->
<header
  id="top"
  class="pt-10 pb-4 text-center sm:pt-14 lg:pt-20 lg:pb-16 lg:text-left"
>
  <div class="lg:grid lg:grid-cols-2 lg:items-center lg:gap-x-14">
    <h1
      class="text-[28px] leading-tight font-black tracking-tight sm:text-[34px] lg:col-start-1 lg:row-start-1 lg:text-[46px]"
    >
      {site.name}
    </h1>

    {
      site.heroImage && (
        /* スマホでは画面いっぱいに広げる */
        <div class="-mx-5 mt-8 sm:-mx-6 lg:col-start-2 lg:row-span-3 lg:row-start-1 lg:mx-0 lg:mt-0 lg:self-center">
          <img
            src={site.heroImage}
            alt={site.heroImageAlt}
            width="1536"
            height="1024"
            fetchpriority="high"
            decoding="async"
            class="w-full bg-surface-2 object-cover lg:rounded-2xl"
          />
        </div>
      )
    }

    <p
      class="mx-auto mt-8 max-w-[26em] text-[15px] text-ink-muted lg:col-start-1 lg:row-start-2 lg:mx-0 lg:mt-6 lg:text-[17px]"
    >
      {site.tagline}
    </p>

    <!-- 一番押したいボタン（1つだけ置く） -->
    <div
      class="mx-auto mt-8 max-w-[380px] lg:col-start-1 lg:row-start-3 lg:mx-0 lg:mt-8"
    >
      <CtaButton href={mainCta.url} label={mainCta.label} />
      {
        mainCta.note && (
          <p class="mt-3 text-[12px] text-ink-muted">{mainCta.note}</p>
        )
      }
    </div>
  </div>
</header>
