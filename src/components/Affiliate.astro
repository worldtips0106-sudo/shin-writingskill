---
import Section from "./Section.astro";
import { affiliates } from "../data/site";
---

<!-- pr={true} で見出し横に「PR」ラベルが出ます（ステマ規制対応・消さないでください） -->
<Section
  id="items"
  title={affiliates.heading}
  lead={affiliates.lead}
  pr={true}
>
  <p class="-mt-3 mb-6 text-[12px] text-ink-muted">
    このセクションにはアフィリエイトリンクを含みます。
  </p>

  <div class="space-y-4 lg:grid lg:grid-cols-2 lg:gap-5 lg:space-y-0">
    {
      affiliates.items.map((item) => (
        <article class="rounded-2xl border border-hairline bg-surface p-6 shadow-[0_1px_3px_rgba(33,37,42,0.05)]">
          <h3 class="text-[17px] font-bold">{item.name}</h3>
          <p class="mt-3 text-[14px] text-ink-muted">{item.comment}</p>

          <a
            href={item.url}
            target="_blank"
            rel="sponsored nofollow noopener"
            class="mt-5 inline-flex items-center gap-2 text-[14px] font-bold text-accent hover:underline"
          >
            商品を見る
            <span aria-hidden="true">→</span>
          </a>
        </article>
      ))
    }
  </div>
</Section>
