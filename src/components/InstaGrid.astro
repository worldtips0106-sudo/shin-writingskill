---
import Section from "./Section.astro";
import { instagram } from "../data/site";
---

<Section id="instagram" title={instagram.heading}>
  <a
    href={instagram.profileUrl}
    target="_blank"
    rel="noopener"
    class="text-[14px] text-accent hover:underline"
  >
    {instagram.handle}
  </a>

  <!-- 3列グリッド。画像をタップすると、その投稿が別タブで開きます -->
  <div class="mt-5 grid grid-cols-3 gap-1.5">
    {
      instagram.posts.map((post) => (
        <a
          href={post.url}
          target="_blank"
          rel="noopener"
          class="group relative block overflow-hidden rounded-md bg-surface-2"
        >
          <img
            src={post.image}
            alt={post.alt}
            loading="lazy"
            class="aspect-square w-full object-cover transition duration-300 group-hover:scale-105 group-hover:opacity-80"
            onerror="this.onerror=null; this.src='/images/_placeholder.svg';"
          />
        </a>
      ))
    }
  </div>

  <a
    href={instagram.profileUrl}
    target="_blank"
    rel="noopener"
    class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-full border border-hairline px-6 py-3.5 text-[14px] font-bold transition hover:border-accent hover:text-accent"
  >
    Instagramで他の投稿も見る
    <span aria-hidden="true">→</span>
  </a>
</Section>
