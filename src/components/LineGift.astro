---
import { lineGift, mainCta } from "../data/site";
import CtaButton from "./CtaButton.astro";
---

<!-- このサイトの主導線。他のボタンより目立たせる -->
<section id="line" class="mt-14 lg:mt-20">
  <div
    class="mx-auto max-w-[760px] rounded-2xl border border-accent/40 bg-surface px-5 py-8 text-center shadow-[0_1px_3px_rgba(33,37,42,0.05)] sm:px-9 sm:py-10 lg:px-14 lg:py-14"
  >
    <p class="text-[12px] tracking-[0.2em] text-accent">FREE GIFT</p>

    <h2 class="mt-3 text-[22px] leading-snug font-black lg:text-[28px]">
      {lineGift.heading}
    </h2>

    <p class="mt-4 text-[17px] font-bold text-accent lg:text-[20px]">
      {lineGift.giftName}
    </p>

    <p class="mt-4 text-[15px] text-ink-muted">{lineGift.lead}</p>

    <ul class="mx-auto mt-7 max-w-[520px] space-y-3 border-t border-hairline pt-7 text-left">
      {
        lineGift.benefits.map((benefit) => (
          <li class="flex gap-3 text-[14px]">
            <span class="text-accent" aria-hidden="true">
              ✓
            </span>
            <span>{benefit}</span>
          </li>
        ))
      }
    </ul>

    <div class="mx-auto mt-8 max-w-[380px]">
      <CtaButton href={mainCta.url} label={mainCta.label} />
      {
        mainCta.note && (
          <p class="mt-3 text-[12px] text-ink-muted">{mainCta.note}</p>
        )
      }
    </div>
  </div>
</section>
